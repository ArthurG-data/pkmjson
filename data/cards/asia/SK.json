{"id":"SK-014","uuid":"286c76f6-c9f8-5535-9a91-26617160e184","oracleId":"7b0aee16-09b3-5706-ac8c-1f6f1c81abb4","localId":"014","category":"Trainer","name":{"zh-tw":"道具拆除器","ja":"ツールスクラッパー"},"illustrator":"Studio Bora Inc.","regulationMark":"D","trainerType":"Item","effect":{"zh-tw":"選擇最多2張雙方的場上寶可夢身上附加的「寶可夢道具」卡，將其丟棄。","ja":"おたがいの場のポケモンについている「ポケモンのどうぐ」を2枚まで選び、トラッシュする。"},"legal":{"standard":false,"expanded":false},"imageLanguages":["zh-tw"],"versions":[{"finishes":null,"printings":{"zh-tw":{"uuid":"2521e4d5-2564-5b3b-9635-76a700402b8d"}}}]},
