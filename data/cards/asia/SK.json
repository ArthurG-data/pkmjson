{"id":"SK-003","uuid":"a11a4f34-1bfb-58e7-ac3f-39ca369d20a6","oracleId":"c872bb2f-22c9-5e82-ae51-d2774beedf98","localId":"003","category":"Pokemon","name":{"zh-tw":"雪童子","ja":"ユキワラシ"},"illustrator":"Kouki Saitou","regulationMark":"E","hp":60,"types":["Water"],"stage":"Basic","retreat":1,"dexId":[361],"description":{"zh-tw":"只能在寒冷的土地上生存。即使在零下１００度的環境下也能充滿活力地到處蹦蹦跳跳。","ja":"寒い 土地でしか 生きられない。 マイナス １００度の 環境でも 元気に 跳ねまわっているよ。"},"attacks":[{"name":{"zh-tw":"頭錘","ja":"ずつき"},"damage":30,"cost":["Water","Colorless"]}],"weaknesses":[{"type":"Metal","value":"×2"}],"legal":{"standard":false,"expanded":false},"imageLanguages":["zh-tw"],"versions":[{"finishes":null,"printings":{"zh-tw":{"uuid":"e3a5f1e7-96d1-5f2b-980c-0b68009084c7"}}}]},
{"id":"SK-004","uuid":"e779fdb7-1c3d-5a52-b3da-84a3dd20c3ab","oracleId":"2e169eca-caa7-5805-9a2f-2b6ba2d751e8","localId":"004","category":"Pokemon","name":{"zh-tw":"雪妖女","ja":"ユキメノコ"},"illustrator":"Souichirou Gunjima","regulationMark":"E","hp":90,"types":["Water"],"stage":"Stage1","retreat":1,"dexId":[478],"description":{"zh-tw":"會吐出零下５０度的冷氣凍住獵物，並把牠們帶回自己的巢穴，整齊地擺成一排。","ja":"マイナス５０度の 冷気を 吐き 凍らせた 獲物を すみかに 持ち帰り きれいに 並べる。"},"attacks":[{"name":{"zh-tw":"水晶吐息","ja":"クリスタルブレス"},"effect":{"zh-tw":"在下個自己的回合，這隻寶可夢無法使用招式。","ja":"次の自分の番、このポケモンはワザが使えない。"},"damage":90,"cost":["Water","Colorless"]}],"abilities":[{"type":"Ability","name":{"zh-tw":"降霜","ja":"しもふらし"},"effect":{"zh-tw":"在自己的回合，當從手牌使出這張卡並完成進化時，可使用1次。從自己的棄牌區選擇1張【水】能量卡，附於自己的寶可夢身上。","ja":"自分の番に、このカードを手札から出して進化させたとき、1回使える。自分のトラッシュからエネルギーを1枚選び、自分のポケモンにつける。"}}],"weaknesses":[{"type":"Metal","value":"×2"}],"legal":{"standard":false,"expanded":false},"imageLanguages":["zh-tw"],"versions":[{"finishes":null,"printings":{"zh-tw":{"uuid":"879a47f9-cc58-56aa-a131-0d39e3e239e0"}}}]},
{"id":"SK-005","uuid":"dda319cd-ed87-54ac-94f2-617f2887dbc4","oracleId":"df32ce3c-37a7-5288-9149-285269ce7b1e","localId":"005","category":"Pokemon","name":{"zh-tw":"咩利羊","ja":"メリープ"},"illustrator":"Miki Tanaka","regulationMark":"E","hp":70,"types":["Lightning"],"stage":"Basic","retreat":2,"dexId":[179],"description":{"zh-tw":"會累積絨毛摩擦時所產生的電力。如果因為牠可愛而直接用手去摸，就會被電得又麻又痛。","ja":"綿毛が こすれ 電気が たまる。 かわいいからと 素手で 触ると バチッと 痺れて 痛いのだ。"},"attacks":[{"name":{"zh-tw":"叫聲","ja":"なきごえ"},"effect":{"zh-tw":"在下個對手的回合，受到這個招式的寶可夢使用招式的傷害「-20」點。","ja":"次の相手の番、このワザを受けたポケモンが使うワザのダメージは「-20」される。"},"cost":["Colorless"]},{"name":{"zh-tw":"劈哩啪啦","ja":"バチバチ"},"damage":20,"cost":["Lightning","Colorless"]}],"weaknesses":[{"type":"Fighting","value":"×2"}],"legal":{"standard":false,"expanded":false},"imageLanguages":["zh-tw"],"versions":[{"finishes":null,"printings":{"zh-tw":{"uuid":"ef0b2890-b009-5057-a3f7-4f9e63dd1d6e"}}}]},
{"id":"SK-006","uuid":"5ee6cd04-7911-5e32-84d0-3e4d348dabeb","oracleId":"e910bdfa-35b1-583e-9a5c-bd430b55b56c","localId":"006","category":"Pokemon","name":{"zh-tw":"茸茸羊","ja":"モココ"},"illustrator":"OKACHEKE","regulationMark":"E","hp":90,"types":["Lightning"],"stage":"Stage1","retreat":2,"dexId":[180],"description":{"zh-tw":"會將電力儲存在鬆軟的毛中。因為儲存了太多電力，身上有些地方變得光禿禿的。","ja":"ふかふかの 毛に 電気を ためこむ。 蓄えすぎて ところどころ つるつるに 禿げあがって しまった。"},"attacks":[{"name":{"zh-tw":"電球","ja":"エレキボール"},"damage":50,"cost":["Lightning","Lightning","Colorless"]}],"abilities":[{"type":"Ability","name":{"zh-tw":"電氣發電機","ja":"エレキダイナモ"},"effect":{"zh-tw":"在自己的回合時，可使用1次。從自己的棄牌區選擇1張【雷】能量卡，附於備戰寶可夢身上。","ja":"自分の番に1回使える。自分のトラッシュからエネルギーを1枚選び、ベンチポケモンにつける。"}}],"weaknesses":[{"type":"Fighting","value":"×2"}],"legal":{"standard":false,"expanded":false},"imageLanguages":["zh-tw"],"versions":[{"finishes":null,"printings":{"zh-tw":{"uuid":"9543c10f-fa58-5c57-8b9b-68ec842f9be7"}}}]},
{"id":"SK-007","uuid":"c67618f2-c150-55e8-8532-4b6ca57f7c3d","oracleId":"69d65487-754f-58e3-94f4-180f690eeac6","localId":"007","category":"Pokemon","name":{"zh-tw":"夢幻","ja":"ミュウ"},"illustrator":"Yuu Nishida","regulationMark":"E","hp":60,"types":["Psychic"],"stage":"Basic","retreat":1,"dexId":[151],"description":{"zh-tw":"遺伝子には　すべての　ポケモンの情報が　含まれているのであらゆる　技が　使えるという。","ja":"遺伝子には すべての ポケモンの 情報が 含まれているので あらゆる 技が 使えるという。"},"attacks":[{"name":{"zh-tw":"精神射擊","ja":"サイコショット"},"damage":30,"cost":["Psychic","Colorless"]}],"abilities":[{"type":"Ability","name":{"zh-tw":"神秘尾巴","ja":"ふしぎなしっぽ"},"effect":{"zh-tw":"若這隻寶可夢在戰鬥場上，則在自己的回合時可使用1次。查看自己的牌庫上方6張卡。選擇其中1張物品卡，在給對手看過後加入手牌。將剩餘卡放回牌庫並重洗。","ja":"このポケモンがバトル場にいるなら、自分の番に1回使える。自分の山札を上から6枚見る。その中からグッズを1枚選び、相手に見せて、手札に加える。残りのカードは山札にもどして切る。"}}],"weaknesses":[{"type":"Darkness","value":"×2"}],"resistances":[{"type":"Fighting","value":"－30"}],"legal":{"standard":false,"expanded":false},"imageLanguages":["zh-tw"],"versions":[{"finishes":null,"printings":{"zh-tw":{"uuid":"a5476cf8-7d30-5d5e-875f-e7aa5d45aea2"}}}]},
{"id":"SK-008","uuid":"5972b8b8-3f11-517b-a259-d3a76387e0ee","oracleId":"2ed4aece-c156-5eed-8e84-6087df492206","localId":"008","category":"Pokemon","name":{"zh-tw":"叉字蝠V","ja":"クロバットV"},"illustrator":"PLANETA Mochizuki","regulationMark":"D","hp":180,"types":["Darkness"],"stage":"Basic","suffix":"V","retreat":1,"attacks":[{"name":{"zh-tw":"毒牙","ja":"どくのキバ"},"effect":{"zh-tw":"將對手的戰鬥寶可夢【中毒】。","ja":"相手のバトルポケモンをどくにする。"},"damage":70,"cost":["Darkness","Colorless"]}],"abilities":[{"type":"Ability","name":{"zh-tw":"暗夜能源","ja":"ナイトアセット"},"effect":{"zh-tw":"在自己的回合，當從手牌將這張卡放置於備戰區時，可使用1次。從牌庫抽卡直到自己的手牌滿6張為止。在這個回合，若已經使出了其他的「暗夜能源」，則這個特性無法使用。","ja":"自分の番に、このカードを手札からベンチに出したとき、1回使える。自分の手札が6枚になるように、山札を引く。この番、すでに別の「ナイトアセット」を使っていたなら、この特性は使えない。"}}],"weaknesses":[{"type":"Fighting","value":"×2"}],"legal":{"standard":false,"expanded":false},"imageLanguages":["zh-tw"],"versions":[{"finishes":null,"printings":{"zh-tw":{"uuid":"cf824406-ddf6-57ac-a97e-52708176d890"}}}]},
