{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArthurG-data/pkmjson/schema/uuids.schema.json",
  "title": "pkmjson UUID registry, one kind",
  "description": "data/uuids/<kind>.json, kept by tools/uuids.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keys",
    "bridges"
  ],
  "properties": {
    "keys": {
      "description": "Identity key -> UUID. Only grows; a value never changes. printings.json groups its keys by the card UUID they start with: {card UUID: {'<language>:<version key>': UUID}}.",
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/uuid"
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/uuid"
            }
          }
        ]
      }
    },
    "bridges": {
      "description": "Alias key -> the UUID it was last on.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/uuid"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
