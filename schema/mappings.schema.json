{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArthurG-data/pkmjson/schema/mappings.schema.json",
  "title": "pkmjson mappings",
  "description": "The hand-kept and exported lookup tables in mappings/, one $defs entry per file.",
  "$defs": {
    "tcgplayer_groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "groupId",
          "region",
          "set"
        ],
        "properties": {
          "groupId": {
            "type": "integer",
            "minimum": 1
          },
          "region": {
            "enum": [
              "international",
              "asia"
            ]
          },
          "set": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+(?:[.+-]?[A-Za-z0-9+]+)*$"
          }
        }
      }
    },
    "cardmarket_sealed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tcgplayerProductId",
          "cardmarketProductId"
        ],
        "properties": {
          "tcgplayerProductId": {
            "type": "integer",
            "minimum": 1
          },
          "cardmarketProductId": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "pack_pools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraSets"
      ],
      "properties": {
        "extraSets": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(international|asia)/[A-Za-z0-9.+-]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]+(?:[.+-]?[A-Za-z0-9+]+)*$"
            }
          }
        },
        "pools": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]+(?:[.+-]?[A-Za-z0-9+]+)*$"
            }
          }
        },
        "skip": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
